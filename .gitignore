# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — asla commit etmeyin
.env
.env.local
.env.*.local
!.env.example

# prisma / sqlite
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*
/data/

# uploads (içerik; klasör iskeleti kalsın)
/public/uploads/instructors/*
!/public/uploads/instructors/.gitkeep
/public/uploads/documents/*
!/public/uploads/documents/.gitkeep
/public/uploads/gallery/*
!/public/uploads/gallery/.gitkeep

# yayin paketleri
/yayin/
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
